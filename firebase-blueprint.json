{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with credentials and role attributes",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 30 },
        "role": { "type": "string", "enum": ["visitor", "customer", "business_owner", "verified_owner", "admin"] },
        "avatar": { "type": "string", "maxLength": 500 },
        "savedBusinessIds": { "type": "array" },
        "ownedBusinessIds": { "type": "array" },
        "twoFactorEnabled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "role", "createdAt"]
    },
    "Business": {
      "title": "Business",
      "description": "Deep verified Ghanaian business profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "slug": { "type": "string", "maxLength": 160 },
        "category": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 3000 },
        "logo": { "type": "string", "maxLength": 500 },
        "coverImage": { "type": "string", "maxLength": 500 },
        "phone": { "type": "string", "maxLength": 30 },
        "whatsapp": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "format": "email", "maxLength": 120 },
        "website": { "type": "string", "maxLength": 300 },
        "city": { "type": "string", "maxLength": 80 },
        "region": { "type": "string", "maxLength": 80 },
        "address": { "type": "string", "maxLength": 250 },
        "digitalAddress": { "type": "string", "maxLength": 50 },
        "priceLevel": { "type": "string", "enum": ["$", "$$", "$$$", "$$$$"] },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "verificationStatus": { "type": "string", "enum": ["verified", "pending", "rejected", "unverified"] },
        "views": { "type": "number" },
        "leadsCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "category", "city", "phone", "rating"]
    },
    "BusinessReview": {
      "title": "BusinessReview",
      "description": "Customer ratings and verified reviews",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "businessId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 120 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 2000 },
        "date": { "type": "string", "format": "date-time" },
        "helpfulCount": { "type": "number" }
      },
      "required": ["id", "businessId", "userName", "rating", "comment"]
    },
    "BusinessInquiry": {
      "title": "BusinessInquiry",
      "description": "Lead and quote request inquiry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "businessId": { "type": "string", "maxLength": 128 },
        "businessName": { "type": "string", "maxLength": 150 },
        "clientName": { "type": "string", "maxLength": 120 },
        "clientPhone": { "type": "string", "maxLength": 30 },
        "clientEmail": { "type": "string", "format": "email", "maxLength": 120 },
        "serviceRequested": { "type": "string", "maxLength": 150 },
        "message": { "type": "string", "maxLength": 2500 },
        "status": { "type": "string", "enum": ["new", "contacted", "completed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "businessId", "clientName", "clientPhone", "message"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Authenticated user accounts and saved data"
    },
    "/businesses/{businessId}": {
      "schema": { "$ref": "#/entities/Business" },
      "description": "Verified Ghanaian business directory records"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/BusinessReview" },
      "description": "Verified customer reviews and feedback"
    },
    "/inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/BusinessInquiry" },
      "description": "Customer quotes and inquiry leads"
    }
  }
}
