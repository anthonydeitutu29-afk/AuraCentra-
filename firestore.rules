rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles: Public basic read for reviewer avatars/names, strictly owner or admin write
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && (request.auth.uid == userId);
      allow delete: if isAuthenticated() && (request.auth.uid == userId);
    }

    // Businesses directory: Public read, authenticated business owners or admin write
    match /businesses/{businessId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid || 
        !('ownerId' in resource.data) ||
        request.auth.token.email == 'admindashboard@gmail.com'
      );
      allow delete: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        request.auth.token.email == 'admindashboard@gmail.com'
      );
    }

    // Categories: Public read
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Reviews: Public read, authenticated creation
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }

    // Inquiries: Authenticated or client lead submission
    match /inquiries/{inquiryId} {
      allow read: if isAuthenticated();
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }

    // Reports: Anyone can submit, authenticated / admin can manage
    match /reports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }

    // Category suggestions
    match /suggestions/{suggestionId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }

    // Feedback
    match /feedback/{feedbackId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }
  }
}
